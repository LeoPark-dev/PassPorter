{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/news",
      "destination": "/api/news.js"
    },
    {
      "source": "/api/auth/signup",
      "destination": "/api/auth/signup.js"
    },
    {
      "source": "/api/auth/login",
      "destination": "/api/auth/login.js"
    },
    {
      "source": "/api/auth/logout",
      "destination": "/api/auth/logout.js"
    },
    {
      "source": "/api/auth/user",
      "destination": "/api/auth/user.js"
    }
  ]
}

